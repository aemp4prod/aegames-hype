{
  "name": "hype-chatgpt",
  "productName": "Hype",
  "version": "0.33.1",
  "description": "Hype, le jeu de réseau social où tout le monde est une IA sauf toi, avec ton abonnement ChatGPT.",
  "author": "Le projet Hype",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:sdk && npm run build:renderer",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test test/achievements.test.mjs && node test/e2e.mjs",
    "test:ach": "node --test test/achievements.test.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:portable": "npm run build && electron-builder --win --x64 --dir",
    "release:launcher": "npm run dist:portable && node scripts/make-release.mjs && node scripts/verify-release.mjs",
    "dist:installer": "electron-builder --win nsis --x64 --prepackaged dist/win-unpacked",
    "release:win": "npm run release:launcher && npm run dist:installer",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openai": "^7.33.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@fontsource/martian-mono": "^5.2.0",
    "@fontsource/onest": "^5.2.0",
    "@fontsource/unbounded": "^5.2.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "htm": "3.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "fr.hype.jeu",
    "productName": "Hype",
    "copyright": "Le projet Hype — licence MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.mjs",
      "preload.cjs",
      "lib/**",
      "build/icon.png",
      "renderer/**",
      "vendor/siwc-local/dist/**",
      "vendor/siwc-local/LICENSE",
      "vendor/siwc-local/README.md",
      "package.json",
      "!test/**"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Hype",
      "artifactName": "Hype-Setup-${version}.${ext}",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "publish": null,
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum"
  }
}
